# 复制为 backend/.env 后修改。真实 .env 不要提交到 git。

# PostgreSQL（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://ainovel:ainovel@localhost:5432/ainovel

# JWT 签名密钥（至少 16 字符），生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# API Key 加密主密钥（Fernet），缺失或非法时服务拒绝启动。生成：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：更换后已保存的 API Key 将无法解密，需要重新填写
ENCRYPTION_KEY=

# 是否开放注册（关闭后可由管理员在「用户管理」中创建账号）
REGISTRATION_ENABLED=true

# 首个管理员（可选，须同时设置，只设一个会启动失败；规则同注册）
# 启动时账号不存在则创建为管理员；已存在则设为启用中的管理员，不会覆盖其密码
ADMIN_USERNAME=
ADMIN_PASSWORD=

# HTTPS 部署时设为 true（Cookie 加 Secure 标记）
COOKIE_SECURE=false

# 登录有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 平台开放读取接口：每把 API Key 每分钟最多请求数，不影响网页内部接口
OPEN_API_RATE_LIMIT_PER_MINUTE=120

# 允许跨域的前端地址（逗号分隔）；同源部署可留空
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 章节生成上下文的字符预算
CONTEXT_CHAR_BUDGET=12000

# 是否允许 AI Base URL 指向本地 / 内网地址（本地开发接 Ollama 时设为 true；公网开放注册部署请保持 false）
ALLOW_PRIVATE_AI_ENDPOINTS=false

# 单次 AI 请求超时（秒）
AI_REQUEST_TIMEOUT=300

# 自动章节分析的部署级开关：与项目「自动分析」同时开启才会在 AI 生成 / 润色 / 重写成功后自动排队分析；手动分析不受影响
AUTO_ANALYZE_ENABLED=true
# 是否允许用户接入远程 MCP 插件（项目智能体的外部工具）；false 时插件接口返回 403、智能体不暴露 MCP 工具
MCP_ENABLED=true

# 前端构建产物目录（存在时由后端托管并做 SPA fallback），默认 ../frontend/dist
# FRONTEND_DIST_DIR=/app/frontend/dist
