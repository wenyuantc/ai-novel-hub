# 复制为 .env 后填写：cp .env.example .env

# PostgreSQL
POSTGRES_USER=ainovel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ainovel

# JWT 签名密钥（随机长字符串）：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# API Key 加密主密钥（Fernet）：python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 注意：更换后已保存的 API Key 将无法解密，需要重新填写
ENCRYPTION_KEY=change-me

# 是否开放注册（关闭后可由管理员在「用户管理」中创建账号）
REGISTRATION_ENABLED=true

# 首个管理员（可选，须同时设置；规则同注册：用户名 3-32 位无空白，密码 6-72 字节）
# 启动时账号不存在则创建为管理员；已存在则设为启用中的管理员，不会覆盖其密码
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 通过 HTTPS 访问时设为 true
COOKIE_SECURE=false
# 登录有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 平台开放读取接口：每把 API Key 每分钟最多请求数
OPEN_API_RATE_LIMIT_PER_MINUTE=120

# 是否允许 AI Base URL 指向本地 / 内网地址（接入本机 Ollama 等本地模型时设为 true）
# 开放注册并部署在公网时请保持 false，否则任何注册用户都能让服务器访问内网（SSRF）
ALLOW_PRIVATE_AI_ENDPOINTS=false

# 章节生成时带入的上下文字符预算
CONTEXT_CHAR_BUDGET=12000
# 单次 AI 请求超时（秒）
AI_REQUEST_TIMEOUT=300
# 后台 AI 任务（整章生成 / 润色 / 向导）：全局同时运行上限、每个用户同时运行上限，其余排队
TASK_MAX_CONCURRENCY=4
TASK_MAX_PER_USER=2
# 自动章节分析的部署级开关：AI 生成 / 润色 / 按建议重写成功后，部署开关与项目「自动分析」都开启才自动排队分析本章
# 设为 false 可全局关闭（每次会多一次 AI 调用）；手动分析与一键分析不受影响
AUTO_ANALYZE_ENABLED=true
# 是否允许用户接入远程 MCP 插件（项目智能体的外部工具）；false 时插件接口返回 403、智能体不暴露 MCP 工具
MCP_ENABLED=true

APP_PORT=8000

# 整库备份部署参数；计划、S3/SMTP与恢复密码在管理后台单独配置。
# Compose中为宿主机挂载路径；容器内固定/app/backups。首次定时关闭、文件加密默认开启。
BACKUP_DIR=./backups
BACKUP_PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump
BACKUP_GPG_PATH=gpg
BACKUP_GPGCONF_PATH=gpgconf
BACKUP_TIMEOUT_SECONDS=3600
# 默认禁止私网S3/SMTP。显式允许后仍禁止云元数据和链路本地地址；TLS不能关闭。
ALLOW_PRIVATE_BACKUP_ENDPOINTS=false
# 可选容器内自定义CA证书路径，需要另行只读挂载（不能放私钥）。
BACKUP_CA_BUNDLE=
